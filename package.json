{
  "name": "widinx-website",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "WidinX marketing website — digital product passports & end-to-end traceability. Vue 3 + Vite + Tailwind CSS v4, with a small Express relay that creates HubSpot leads.",
  "scripts": {
