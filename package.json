  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "express": "^4.21.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "tailwindcss": "^4.1.0",
    "vite": "^6.3.0"
  }
}
