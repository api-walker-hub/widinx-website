# Copy to .env.local and fill in.

# ---- Lead relay (server/index.js) — server-side only, never prefixed with VITE_
# HubSpot private app token with scopes: crm.objects.contacts.read/write,
# crm.objects.companies.read/write, crm.objects.leads.read/write
HUBSPOT_PRIVATE_APP_TOKEN=
# NA2 portals use api-na2.hubapi.com; EU portals api-eu1.hubapi.com; default US api.hubapi.com
HUBSPOT_API_BASE=https://api-na2.hubapi.com
PORT=8787
# Origins allowed to call the API cross-origin (dev). In production the server
# serves the site itself, so this can stay empty.
ALLOWED_ORIGINS=http://localhost:5180

# ---- Website (bundled by Vite, public)
# Where the demo form posts. Dev: the relay's absolute URL. Prod: /api/leads (see .env.production)
VITE_LEAD_ENDPOINT=http://localhost:8787/api/leads

# Alternative without a server: HubSpot Forms API (public endpoint, needs a form GUID)
VITE_HUBSPOT_PORTAL_ID=
VITE_HUBSPOT_FORM_GUID=

# Public contact addresses shown on the site
VITE_CONTACT_EMAIL=hello@widinx.com
VITE_SECURITY_EMAIL=security@widinx.com
VITE_PRIVACY_EMAIL=privacy@widinx.com
VITE_CAREERS_EMAIL=careers@widinx.com
